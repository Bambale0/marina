[Unit]
Description=Marina outbox and deadlines worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=marina
Group=marina
WorkingDirectory=/opt/marina/current
EnvironmentFile=/etc/marina.env
ExecStart=/opt/marina/current/.venv/bin/python -m marina.cli worker
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/marina

[Install]
WantedBy=multi-user.target
