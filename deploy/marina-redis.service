[Unit]
Description=Marina persistent session Redis
After=local-fs.target

[Service]
Type=simple
User=marina
Group=marina
ExecStart=/usr/bin/redis-server /etc/marina-redis.conf
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/marina/redis

[Install]
WantedBy=multi-user.target
